NEXT_PUBLIC_COLOR_WARS_V1_ADDRESS=0x0000000000000000000000000000000000000000
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
NEXT_PUBLIC_BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# Required in production. Generate with `openssl rand -hex 32`.
SESSION_SECRET=

# Optional but strongly recommended on Vercel / any serverless host.
# Without one of these the in-memory game state (canvas, players, pixels) is
# lost on every cold start. Either Upstash Redis (recommended) or Vercel KV
# works — they share the same REST protocol.
#
# Upstash: https://console.upstash.com → Create database (REST), copy URL+token.
# Vercel KV: project → Storage → Create KV → "Set up env vars" links them.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
